<mxfile host="app.diagrams.net" type="device"><diagram name="1. Requirement Diagram" id="req"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="req-title" value="req [package] Medication Reminder System [Requirements]" style="text;html=1;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="520" height="24" as="geometry"/></mxCell><mxCell id="R0" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Medication Reminder System&lt;/b&gt;&lt;hr/&gt;id = R0&lt;br/&gt;The system shall help patients manage medications and adherence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="250" height="80" as="geometry"/></mxCell><mxCell id="R1" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Medication Management&lt;/b&gt;&lt;hr/&gt;id = R1&lt;br/&gt;Patients manage their medication records (CRUD)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="210" height="90" as="geometry"/></mxCell><mxCell id="R2" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Reminder Scheduling&lt;/b&gt;&lt;hr/&gt;id = R2&lt;br/&gt;Patients schedule dose reminders per medication." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="210" height="90" as="geometry"/></mxCell><mxCell id="R3" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Dose Tracking &amp; Adherence&lt;/b&gt;&lt;hr/&gt;id = R3&lt;br/&gt;System records doses and computes adherence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="210" height="90" as="geometry"/></mxCell><mxCell id="R4" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;User Authentication&lt;/b&gt;&lt;hr/&gt;id = R4&lt;br/&gt;Secure registration and login (JWT)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="210" height="90" as="geometry"/></mxCell><mxCell id="R5" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Admin Management&lt;/b&gt;&lt;hr/&gt;id = R5&lt;br/&gt;Admins manage users and view system stats." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="200" width="150" height="90" as="geometry"/></mxCell><mxCell id="req-2" value="" style="endArrow=none;html=1;startArrow=circlePlus;startFill=0;" edge="1" parent="1" source="R0" target="R1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="req-3" value="" style="endArrow=none;html=1;startArrow=circlePlus;startFill=0;" edge="1" parent="1" source="R0" target="R2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="req-4" value="" style="endArrow=none;html=1;startArrow=circlePlus;startFill=0;" edge="1" parent="1" source="R0" target="R3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="req-5" value="" style="endArrow=none;html=1;startArrow=circlePlus;startFill=0;" edge="1" parent="1" source="R0" target="R4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="req-6" value="" style="endArrow=none;html=1;startArrow=circlePlus;startFill=0;" edge="1" parent="1" source="R0" target="R5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R11" value="&amp;laquo;requirement&amp;raquo;&lt;br/&gt;&lt;b&gt;Add/Edit/Delete Medication&lt;/b&gt;&lt;hr/&gt;id = R1.1&lt;br/&gt;Create, update, delete medications." style="rounded=0;whiteSpace=wrap;html=1;fillCo